#!/bin/sh
# 提交前的四项检查；临时跳过：git commit --no-verify
#
# 启用一次：git config core.hooksPath .githooks
# 查看当前：git config core.hooksPath
set -e

echo "==> ruff check"
uv run ruff check .

echo "==> ruff format --check"
uv run ruff format --check .

echo "==> mypy"
uv run python -m mypy app main.py tests

echo "==> pytest"
uv run python -m pytest tests/ -q

echo "==> 全部通过"
